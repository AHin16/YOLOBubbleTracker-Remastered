/* The desktop counterpart of BIFBAgent's warm white and burgundy workspace. */
QWidget { color: #34323b; font-family: "Microsoft YaHei UI", "Segoe UI"; font-size: 12px; }
QMainWindow, QWidget#researchWorkspace { background: #faf9fb; }
QFrame#workspaceSidebar { background: qlineargradient(x1:0,y1:0,x2:0.4,y2:1,stop:0 #ffffff,stop:1 #fcf3f5); border-right: 1px solid #ece8ee; }
QFrame#workspaceTopbar { background: #ffffff; border-bottom: 1px solid #f0eaf0; }
QFrame#workspaceHero { background: qlineargradient(x1:0,y1:0,x2:1,y2:0.7,stop:0 #fdfbfc,stop:1 #faedf1); border-bottom: 1px solid #f0e8ec; }
QLabel { background: transparent; }
QLabel[role="brand"] { color: #bd2030; font-family: "Segoe UI"; font-size: 25px; font-weight: 750; letter-spacing: 2px; }
QLabel[role="brandCaption"] { color: #a3969e; font-size: 9px; letter-spacing: 0.5px; }
QLabel[role="sectionCaption"] { color: #ab9aa4; font-family: "Segoe UI"; font-size: 9px; letter-spacing: 1px; padding-left: 10px; }
QLabel[role="sidebarNote"] { color: #a08a95; font-size: 10px; padding: 8px 6px; }
QFrame[role="sidebarRule"] { background: #ebdfe5; border: none; }
QLabel[role="eyebrow"] { color: #b38795; font-family: "Segoe UI"; font-size: 9px; letter-spacing: 1.5px; }
QLabel[role="pageTitle"] { color: #322832; font-size: 25px; font-weight: 650; }
QLabel[role="subtitle"] { color: #847580; font-size: 12px; }
QLabel[role="pageNumber"] { color: #cfb8c2; font-family: "Segoe UI"; font-size: 17px; padding-left: 16px; }
QLabel[role="muted"], QLabel[role="pageNote"] { color: #94838e; font-size: 11px; }
QLabel[role="pageNote"] { padding: 0 3px 2px 3px; }
QLabel[role="localBadge"] { color: #78928a; font-size: 10px; }
QLabel[role="fieldLabel"] { color: #82727d; font-size: 11px; }
QPushButton { background: #ffffff; color: #6d5d67; border: 1px solid #e8e0e6; border-radius: 7px; padding: 7px 12px; min-height: 16px; }
QPushButton:hover { background: #fcf3f5; color: #bd2030; border-color: #dfb4be; }
QPushButton:pressed { background: #f5e5e9; }
QPushButton:focus { border-color: #bd2030; }
QPushButton:disabled { color: #c3b9c0; background: #f6f3f5; border-color: #eee8ed; }
QPushButton[role="navigation"] { background: transparent; text-align: left; padding: 14px 12px; border: 1px solid transparent; border-radius: 10px; font-size: 13px; color: #796a74; }
QPushButton[role="navigation"]:hover { background: #f9f1f4; }
QPushButton[role="navigation"]:checked { background: #f8e7ec; color: #bd2030; font-weight: 600; }
QPushButton[role="navigation"]:focus { border-color: #d89ba8; }
QPushButton[role="primary"] { background: #bd2030; color: #ffffff; border-color: #bd2030; font-weight: 600; padding: 8px 18px; }
QPushButton[role="primary"]:hover { background: #9e1422; border-color: #9e1422; }
QPushButton[role="primary"]:pressed { background: #89111e; }
QPushButton[role="primary"]:disabled { background: #dcb3bc; border-color: #dcb3bc; color: #fff4f6; }
QPushButton[role="stop"]:enabled { color: #a54959; border-color: #e2bcc5; }
QGroupBox { background: #ffffff; border: 1px solid #eae3e9; border-radius: 11px; margin-top: 11px; padding: 16px 6px 6px 6px; font-size: 12px; font-weight: 600; color: #6c5965; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; left: 16px; padding: 0 6px; color: #806672; }
QGroupBox[role="metricGroup"] { background: transparent; border: none; padding: 9px 0 0 0; margin-top: 8px; }
QGroupBox[role="metricGroup"]::title { left: 2px; color: #8e7c87; font-size: 11px; }
QFrame[role="metric"] { background: #ffffff; border: 1px solid #ece3e9; border-radius: 9px; }
QLabel[role="metricTitle"] { color: #9a8793; font-size: 10px; font-weight: 400; }
QLabel[role="metricValue"] { color: #a43b50; font-family: "Segoe UI"; font-size: 18px; font-weight: 600; }
QFrame[role="runPanel"] { background: #ffffff; border: 1px solid #eae3e9; border-radius: 11px; }
QLabel[role="status"] { color: #779184; font-weight: 600; }
QLabel[role="preview"] { background: #f8f5f8; color: #b29fae; border: 1px dashed #e5dbe4; border-radius: 8px; font-size: 12px; padding: 6px; }
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox { background: #ffffff; border: 1px solid #e5dce4; border-radius: 7px; padding: 6px 9px; min-height: 18px; selection-background-color: #bd2030; selection-color: #ffffff; }
QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QComboBox:hover { border-color: #d6b9c5; }
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus { border-color: #bd2030; background: #fffafb; }
QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled { background: #f7f4f6; color: #b7aab3; border-color: #ece5eb; }
QComboBox { padding-right: 25px; }
QComboBox::drop-down { border: none; width: 24px; }
QComboBox QAbstractItemView { background: #ffffff; border: 1px solid #e8dce3; outline: none; selection-background-color: #f8e7ec; selection-color: #bd2030; padding: 4px; }
QSpinBox::up-button, QDoubleSpinBox::up-button { width: 20px; border: none; border-left: 1px solid #eee5ec; border-top-right-radius: 7px; background: #fbf7f9; }
QSpinBox::down-button, QDoubleSpinBox::down-button { width: 20px; border: none; border-left: 1px solid #eee5ec; border-bottom-right-radius: 7px; background: #fbf7f9; }
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover, QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover { background: #f6e7ed; }
QCheckBox { spacing: 8px; color: #86717f; padding: 3px 0; }
QCheckBox::indicator { width: 15px; height: 15px; border-radius: 4px; border: 1px solid #d9c9d3; background: #ffffff; }
QCheckBox::indicator:checked { background: #bd2030; border-color: #bd2030; image: url(__ASSETS__/check.svg); }
QCheckBox::indicator:disabled { background: #f0e9ee; border-color: #e4dbe2; }
QComboBox::down-arrow, QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { image: url(__ASSETS__/chevron-down.svg); width: 10px; height: 7px; }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { image: url(__ASSETS__/chevron-up.svg); width: 10px; height: 7px; }
QTabWidget::pane { background: transparent; border: none; padding-top: 10px; }
QTabWidget#workflowTabs::pane { border: none; padding: 0; }
QTabBar::tab { background: transparent; color: #a08b98; padding: 9px 17px; border: none; border-bottom: 2px solid transparent; font-size: 12px; }
QTabBar::tab:selected { color: #bd2030; border-bottom-color: #bd2030; font-weight: 600; }
QTabBar::tab:hover { background: #faf0f4; color: #bd2030; }
QTabBar::tab:focus { color: #bd2030; }
QScrollArea, QScrollArea > QWidget > QWidget { background: transparent; border: none; }
QScrollBar:vertical { background: transparent; width: 7px; margin: 2px 0; }
QScrollBar::handle:vertical { background: #ddcfd8; min-height: 32px; border-radius: 3px; }
QScrollBar::handle:vertical:hover { background: #c6a6b7; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QScrollBar:horizontal { background: transparent; height: 7px; }
QScrollBar::handle:horizontal { background: #ddcfd8; min-width: 32px; border-radius: 3px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QSplitter::handle { background: transparent; width: 14px; }
QSplitter::handle:hover { background: #f1e7ed; border-radius: 5px; }
QProgressBar { background: #f1eaf0; border: none; border-radius: 3px; min-height: 6px; max-height: 6px; color: transparent; }
QProgressBar::chunk { background: #bd2030; border-radius: 3px; }
QTextEdit, QPlainTextEdit { background: #ffffff; border: 1px solid #ece3ea; border-radius: 9px; padding: 10px; color: #897382; font-family: "Cascadia Code", "Microsoft YaHei UI"; font-size: 11px; selection-background-color: #f6e0e8; }
QTableWidget { background: #ffffff; alternate-background-color: #fcf7f9; gridline-color: #f2eaf0; border: 1px solid #eae1e8; border-radius: 8px; selection-background-color: #f7e5ec; selection-color: #a43b50; outline: none; }
QHeaderView::section { background: #fbf6f9; color: #9b7c8d; border: none; border-bottom: 1px solid #ece1e8; padding: 7px; font-size: 10px; }
QTableWidget::item { padding: 5px; }
QSlider::groove:horizontal { height: 4px; border-radius: 2px; background: #e9dce5; }
QSlider::sub-page:horizontal { background: #c8768b; border-radius: 2px; }
QSlider::handle:horizontal { background: #bd2030; border: 2px solid #ffffff; width: 12px; margin: -5px 0; border-radius: 7px; }
QToolTip { color: #735666; background: #fff9fb; border: 1px solid #e5cbd7; padding: 7px; }
QMessageBox { background: #faf9fb; }
QLabel[role="homeHeading"] { color: #322832; font-size: 21px; font-weight: 650; }
QLabel[role="homeBody"] { color: #685b65; font-size: 12px; }
QLabel[role="homeMeta"] { color: #786772; font-size: 11px; }
QFrame[role="homeWorkflow"] { background: #ffffff; border: 1px solid #e8dfe5; border-radius: 12px; }
QLabel[role="homeWorkflowTitle"] { color: #382c35; font-size: 16px; font-weight: 600; }
QLabel[role="homeNumber"] { color: #986a7b; font-size: 12px; font-family: "Segoe UI"; }
QPushButton[role="homeAction"] { color: #a31c2c; background: #fcf3f5; border-color: #ebcbd3; padding: 6px 16px; font-weight: 600; }
QPushButton[role="homeAction"]:hover { background: #f8e5ea; border-color: #bd2030; }
QPushButton[role="homeAction"]:focus { border: 2px solid #bd2030; padding: 5px 15px; }
QFrame[role="homeGuide"] { background: #f4ecf0; border: 1px solid #e9dce4; border-radius: 12px; }
QLabel[role="homeGuideTitle"] { color: #4f3947; font-size: 15px; font-weight: 600; }
QLabel[role="homeStepTitle"] { color: #503b48; font-size: 12px; font-weight: 600; }
QLabel[role="homeStep"] { color: #a31c2c; background: #ffffff; border: 1px solid #e8d5de; border-radius: 14px; font-weight: 600; }
QFrame[role="homeMethod"] { background: #ffffff; border: 1px solid #e8dce3; border-radius: 8px; }
QWidget#gasHoldupPage QLabel[role="metricValue"] { min-height: 24px; }
